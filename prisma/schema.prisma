// ZAMCOPS Member Portal — database schema (PostgreSQL).
// DATABASE_URL is the pooled connection used at runtime; DIRECT_URL is the
// direct (non-pooled) connection used for migrations / `prisma db push`.

generator client {
  provider      = "prisma-client-js"
  // native — local development
  // rhel-openssl-3.0.x    — Vercel's serverless runtime
  // debian-openssl-3.0.x  — the node:22-bookworm-slim image used for self-hosting
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Staff accounts for the admin dashboard (separate from members).
model AdminUser {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  createdAt    DateTime     @default(now())
  // WIPO Connect user account fields
  firstName    String       @default("")
  language     String       @default("English")
  accountType  String       @default("Operator") // Operator | Agent
  active       Boolean      @default(true)
  tags         String       @default("")
  matchMin     Float?
  matchMax     Float?
  groups       AdminGroup[]
}

// WIPO Connect Security Group: a named set of permissions given to accounts.
model AdminGroup {
  id          String      @id @default(cuid())
  name        String      @unique
  description String      @default("")
  note        String      @default("")
  permissions Json        @default("[]")
  users       AdminUser[]
}

// WIPO Connect Parameters / Technical Settings, kept as one JSON document each.
model AdminSetting {
  key       String   @id
  value     Json     @default("{}")
  updatedAt DateTime @updatedAt
}

// WIPO Connect Dynamic Fields: extra fields staff add to a record kind.
model DynamicField {
  id       String  @id @default(cuid())
  entity   String // Right Owner | Work | Account | License | Distribution Pool | Distribution
  label    String
  type     String  @default("Text") // Text | Number | Date | List | Yes/No
  options  String  @default("") // comma separated, for List
  required Boolean @default(false)
  position Int     @default(0)
}

// WIPO Connect Issue Log: problems the system recorded (failed allocations, imports, syncs).
model IssueLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  source    String   @default("")
  message   String   @db.Text
}

// Who did what on the staff console. Admin identity is denormalised so the
// trail survives even if the staff account is later removed.
model AuditLog {
  id         String   @id @default(cuid())
  adminId    String
  adminName  String
  adminEmail String   @default("")
  action     String // e.g. "member.status", "review.rejected", "password.reset"
  targetType String   @default("") // Member | Work | Single | Album | File | Distribution | ...
  targetId   String   @default("")
  summary    String   @default("")
  // JSON [{ field, from, to }] — what a save actually changed, shown on a
  // record Audit tab. Empty for actions that do not edit fields.
  changes    String   @default("") @db.Text
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
}

// Members of the society — composers, authors and publishers (ZAMCOPS' mandate).
model Member {
  id           String @id @default(cuid())
  memberNumber String @unique
  email        String @unique
  phone        String @unique
  passwordHash String

  fullName      String
  stageName     String @default("")
  nrcOrPassport String @default("")
  dateOfBirth   String @default("")
  gender        String @default("")
  role          String @default("Composer") // Composer | Author | Publisher

  province String @default("")
  district String @default("")
  address  String @default("")

  bankName          String @default("")
  bankAccount       String @default("")
  mobileMoneyNumber String @default("")

  nextOfKinName  String @default("")
  nextOfKinPhone String @default("")

  nrcDocument  String @default("")
  profilePhoto String @default("")
  signature    String @default("") @db.Text // member's signature — transparent PNG data URL, reused on every document they sign

  notificationPrefs String @default("") // JSON { email, sms, royalty, marketing }

  // Society identifiers carried over from the WIPO Connect register.
  ipiNumber     String @default("") // IPI name number (CAE)
  ipiBaseNumber String @default("") // IPI base number
  wipoId        String @default("") // id_interested_party in WIPO Connect

  membershipStatus String   @default("Pending")
  joinedAt         DateTime @default(now())

  // Email verification (OTP sent via Resend at registration).
  emailVerifiedAt DateTime?
  otpHash         String    @default("") // bcrypt hash of the current 6-digit code
  otpExpiresAt    DateTime?
  otpAttempts     Int       @default(0)

  works               WorkDeclaration[]
  singles             SongSubmission[]
  albums              AlbumSubmission[]
  uploads             UploadFile[]
  notifications       Notification[]
  statements          Statement[]
  royalty             RoyaltySummary?
  distributionEntries DistributionEntry[]
  licensableWorks     LicensableWork[]
  licenseRequests     LicenseRequest[]
  documents           MemberDocument[]
  supportTickets      SupportTicket[]
  application         MembershipApplication?
  rightHolder         RightHolder?
}

// The official ZAMCOPS membership application (Individual / Group / Publisher),
// digitised field-for-field from the paper forms. One per member. The member
// fills `payload` (shape defined by lib/applicationForms.ts), staff fill
// `adminFields` (internal number, file, subscription, admission dates, ...).
model MembershipApplication {
  id              String    @id @default(cuid())
  owner           Member    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId         String    @unique
  formType        String    @default("Individual") // Individual | Group | Publisher
  payload         String    @default("{}") @db.Text // JSON — applicant answers
  adminFields     String    @default("{}") @db.Text // JSON — staff-only fields
  status          String    @default("Draft") // Draft | Submitted | Approved | Rejected
  rejectionReason String    @default("")
  membershipClass String    @default("") // e.g. CANDIDATE | FULL — set by staff at approval
  deedAgreedAt    DateTime? // when the member executed the Deed of Assignment
  submittedAt     DateTime?
  decidedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// Reusable official signatures (transparent PNGs) applied at document-generation
// time: the General Manager signs admission letters, the Board Secretary
// counter-signs Deeds of Assignment. Uploading a new image supersedes the old
// one for all future documents. Never exposed through member-facing APIs.
model OfficialSignature {
  id           String   @id @default(cuid())
  office       String   @unique // GENERAL_MANAGER | BOARD_SECRETARY
  officerName  String
  officerTitle String
  image        String   @db.Text // transparent PNG data URL
  updatedBy    String   @default("") // staff name, for the audit trail
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model WorkDeclaration {
  id               String @id @default(cuid())
  owner            Member @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId          String
  title            String
  alternativeTitle String @default("")
  workType         String
  language         String
  genre            String
  duration         String @default("")
  composers        String @default("[]") // JSON string[]
  authors          String @default("[]")
  subAuthors       String @default("[]")
  subArrangers     String @default("[]")
  producers        String @default("[]") // retained for existing rows; no longer collected
  publisher        String @default("")
  publisherIpi     String @default("") // Publisher's IPI / CAE number, for cross-society registration
  ownershipSplits  String @default("[]") // JSON OwnershipSplit[] — each entry now also carries ipiNumber + rightsType
  isrc             String @default("")
  iswc             String @default("")
  audioFile        String @default("") // reference recording — file name
  coverArt         String @default("") // sleeve / cover artwork (data URL or storage URL)
  studioReceipt    String @default("") // studio letter or payment receipt
  lyricsFile       String @default("") // lyric sheet lodged with the work
  dateCreated      String @default("")

  // Fields carried by the society's official WORK DECLARATION form.
  instruments             String @default("") // "Type of music / INSTRUMENTS" on the form
  yearComposed            String @default("")
  soundCarrier            String @default("")
  financedByPublisher     String @default("") // "Finance by Publisher?" — Yes | No
  publishingAgreementDate String @default("")
  publishingValidity      String @default("")
  publishingTerritory     String @default("")
  enclosures              String @default("[]") // JSON string[] — Lyrics | Musical score | Online | CD | Contract | Other

  // Works sent together — an album's tracks — share a batch, and the number the
  // form prints in "Work No" is the work's place within it: track 2 of 10. A
  // single is a batch of one. The society does not issue this number; it comes
  // from what the member submitted.
  batchId String @default("")
  workNo  String @default("")

  // Completed by staff once the work is on the register.
  fileNo       String    @default("")
  factor       String    @default("")
  registeredAt DateTime?

  status          String   @default("Pending")
  rejectionReason String   @default("")
  submittedAt     DateTime @default(now())

  @@index([ownerId])
}

model SongSubmission {
  id              String   @id @default(cuid())
  owner           Member   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId         String
  title           String
  artistName      String
  featuredArtists String   @default("")
  producer        String   @default("")
  genre           String
  releaseDate     String   @default("")
  isrc            String   @default("")
  audioFile       String   @default("")
  coverArt        String   @default("")
  lyricsFile      String   @default("")
  ownershipSplits String   @default("[]")
  status          String   @default("Pending")
  rejectionReason String   @default("")
  submittedAt     DateTime @default(now())

  @@index([ownerId])
}

model AlbumSubmission {
  id              String   @id @default(cuid())
  owner           Member   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId         String
  title           String
  artistName      String
  releaseDate     String   @default("")
  coverArt        String   @default("") // front cover — image data URL
  backCover       String   @default("") // back cover — image data URL
  tracks          String   @default("[]") // JSON Track[]
  studioReceipt   String   @default("") // studio letter or payment receipt
  status          String   @default("Pending")
  rejectionReason String   @default("")
  submittedAt     DateTime @default(now())

  @@index([ownerId])
}

model UploadFile {
  id              String   @id @default(cuid())
  owner           Member   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId         String
  fileName        String
  fileType        String
  linkedTo        String   @default("")
  status          String   @default("Pending")
  rejectionReason String   @default("")
  mimeType        String   @default("")
  fileSize        Int      @default(0)
  data            String   @default("") @db.Text // base64 of the file (small files only — inline fallback)
  url             String   @default("") // Vercel Blob URL (large files)
  uploadedAt      DateTime @default(now())

  @@index([ownerId])
}

model Notification {
  id        String   @id @default(cuid())
  owner     Member   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId   String
  title     String
  body      String
  type      String   @default("info")
  href      String   @default("") // in-app path the member should open, e.g. /support
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([ownerId])
}

model Statement {
  id        String   @id @default(cuid())
  owner     Member   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId   String
  type      String
  title     String
  reference String
  amount    Float?
  issuedAt  DateTime @default(now())

  @@index([ownerId])
}

// One royalty summary per member, with usage logs and top songs stored as JSON.
// Note: these are *detected activity* figures (plays/usage) for internal forecasting —
// members are not shown monetary promises here. Confirmed earnings only become visible
// to a member once an admin publishes a Distribution covering the relevant period.
model RoyaltySummary {
  id             String @id @default(cuid())
  owner          Member @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId        String @unique
  currency       String @default("ZMW")
  totalEstimated Float  @default(0)
  pending        Float  @default(0)
  paid           Float  @default(0)
  usageLogs      String @default("[]") // JSON RoyaltyUsageLog[]
  topSongs       String @default("[]") // JSON top songs
}

// A closed, society-wide distribution period. Stays in Draft (admin-only) while
// amounts are being assembled and reviewed; once Published it becomes visible
// to the affected members — this is the gate that keeps royalties from being
// shown "ahead of time".
model Distribution {
  id          String    @id @default(cuid())
  periodLabel String // e.g. "Q1 2026"
  status      String    @default("Draft") // Draft | Published
  notes       String    @default("")
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  // Set for runs imported from WIPO Connect (their id_distribution).
  wipoId    String?   @unique
  code      String    @default("")
  startDate String    @default("")
  endDate   String    @default("")
  deadline  String    @default("")
  // The run lifecycle beyond Draft / Published: when its allocations were
  // last run, and when it was closed (Done). A closed run is read-only.
  runAt     DateTime?
  closedAt  DateTime?

  entries  DistributionEntry[]
  lines    DistributionLine[]
  links    DistributionPoolLink[]
  reserves Reserve[]
}

// A member's confirmed payout within a given distribution period.
model DistributionEntry {
  id             String       @id @default(cuid())
  distribution   Distribution @relation(fields: [distributionId], references: [id], onDelete: Cascade)
  distributionId String
  owner          Member       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId        String
  amount         Float        @default(0)
  currency       String       @default("ZMW")
  topSongs       String       @default("[]") // JSON [{ title, plays, amount }] — breakdown for this period

  @@unique([distributionId, ownerId])
  @@index([ownerId])
}

// A catalog work the member has opted into ZAMCOPS' direct/sync licensing pool —
// businesses (film, ads, online media, events) can request to license it, with
// ZAMCOPS facilitating the deal and earning a facilitation fee alongside the member.
model LicensableWork {
  id         String   @id @default(cuid())
  owner      Member   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId    String
  workTitle  String
  workRef    String   @default("") // optional id of a linked song/album/work
  usageTypes String   @default("[]") // JSON string[], e.g. ["Film & TV","Advertising","Online content","Live events"]
  minFee     Float?
  notes      String   @default("")
  status     String   @default("Active") // Active | Paused
  createdAt  DateTime @default(now())

  requests LicenseRequest[]

  @@index([ownerId])
}

// An inbound licensing enquiry from a business, brokered by ZAMCOPS.
model LicenseRequest {
  id               String         @id @default(cuid())
  work             LicensableWork @relation(fields: [workId], references: [id], onDelete: Cascade)
  workId           String
  owner            Member         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId          String
  requesterName    String
  requesterCompany String         @default("")
  requesterEmail   String
  usageType        String
  description      String         @default("")
  proposedFee      Float?
  facilitationFee  Float?
  status           String         @default("Submitted") // Submitted | In review | Offer sent | Accepted | Declined
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([ownerId])
  @@index([workId])
}

// A help-desk query from a member (or a signed-out visitor asking for a
// password reset). Staff answer and resolve these from the admin Support Inbox;
// the reply is pushed back to the member as a notification and shown on the
// member's Support page.
model SupportTicket {
  id         String    @id @default(cuid())
  owner      Member?   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId    String?
  contact    String    @default("") // identifier supplied on signed-out requests
  topic      String
  message    String    @db.Text
  status     String    @default("Open") // Open | Resolved
  reply      String    @default("")
  thread     String    @default("[]") // JSON ThreadMessage[] — conversation after the opening query
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([ownerId])
}

// Official documents on a member's file — clearance letters, deeds of
// assignment, signed contracts, ID copies, plus the PDFs the system generates
// at approval (application form, signed deed, admission letter). Generated
// PDFs carry their bytes inline in `data`; members may download them only
// once their membership is approved.
model MemberDocument {
  id         String   @id @default(cuid())
  owner      Member   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId    String
  docType    String // Clearance Letter | Deed of Assignment | Contract | ID Document | Membership Application | Admission Letter | Other
  fileName   String
  reference  String   @default("")
  note       String   @default("")
  mimeType   String   @default("")
  data       String   @default("") @db.Text // base64 of the file (generated PDFs)
  url        String   @default("") // external/Blob URL alternative
  generated  Boolean  @default(false) // true when issued by the system at approval
  uploadedAt DateTime @default(now())

  @@index([ownerId])
}

// ── WIPO Connect register ───────────────────────────────────────────────────
// Imported by scripts/import-wipo.mjs. Every row carries the WIPO Connect id it
// came from, so the import can be re-run without duplicating anything.

// Any right-holder on the register: a member, or a co-writer / publisher / heir
// who has no portal account. `member` is set when the import matched them to
// one (by IPI, NRC, email or phone).
model RightHolder {
  id             String   @id @default(cuid())
  wipoId         String   @unique
  member         Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  memberId       String?  @unique
  kind           String   @default("Person") // Person | Legal entity
  displayName    String
  firstName      String   @default("")
  lastName       String   @default("")
  ipiNumber      String   @default("") // IPI name number (CAE)
  ipiBaseNumber  String   @default("")
  identifiers    String   @default("[]") @db.Text // JSON [{ code, label, value }] — every identifier on the WIPO record
  nrc            String   @default("")
  sex            String   @default("")
  birthDate      String   @default("")
  deathDate      String   @default("")
  status         String   @default("")
  isAffiliated   Boolean  @default(false)
  affiliatedFrom String   @default("")
  region         String   @default("")
  nextOfKin      String   @default("")
  spouse         String   @default("")
  matchedBy      String   @default("") // ipi | nrc | email | phone | invite | "" — how memberId was found
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Invitation to open a portal account. Staff add an email (or the WIPO
  // contact email is used); the invite link carries a one-time token whose
  // SHA-256 is stored here, never the token itself. Signing up through the
  // link links the new Member to this record. Plain columns and an index only:
  // a new unique constraint would stop the container's schema push.
  inviteEmail     String    @default("")
  inviteTokenHash String    @default("")
  inviteSentAt    DateTime?
  inviteExpiresAt DateTime?
  inviteCount     Int       @default(0)

  names     RightHolderName[]
  addresses RightHolderAddress[]
  contacts  RightHolderContact[]
  shares    WorkShare[]
  lines     DistributionLine[]
  groups    RightHolderGroupMember[]

  @@index([displayName])
  @@index([ipiNumber])
  @@index([nrc])
  @@index([inviteTokenHash])
}

// A right-holder can be known under several names (legal name, pseudonym, ...),
// each with its own IPI name number.
model RightHolderName {
  id            String      @id @default(cuid())
  wipoNameId    String      @unique
  rightHolder   RightHolder @relation(fields: [rightHolderId], references: [id], onDelete: Cascade)
  rightHolderId String
  name          String
  firstName     String      @default("")
  nameType      String      @default("")
  ipiNameNumber String      @default("")

  shares WorkShare[]

  @@index([rightHolderId])
}

model RightHolderAddress {
  id            String      @id @default(cuid())
  rightHolder   RightHolder @relation(fields: [rightHolderId], references: [id], onDelete: Cascade)
  rightHolderId String
  line1         String      @default("")
  line2         String      @default("")
  line3         String      @default("")
  city          String      @default("")
  province      String      @default("")
  postcode      String      @default("")
  country       String      @default("")
  addressType   String      @default("")

  @@index([rightHolderId])
}

model RightHolderContact {
  id            String      @id @default(cuid())
  rightHolder   RightHolder @relation(fields: [rightHolderId], references: [id], onDelete: Cascade)
  rightHolderId String
  contactType   String      @default("")
  value         String      @default("")
  email         String      @default("")
  phone         String      @default("")
  contactName   String      @default("")
  department    String      @default("")

  @@index([rightHolderId])
}

// A work on the society's register — the WIPO Connect works list. Distinct from
// WorkDeclaration, which is a member's submission awaiting review; a declaration
// that has been registered links to its register entry through `declarationId`.
model RegistryWork {
  id                String   @id @default(cuid())
  wipoId            String   @unique
  title             String
  alternativeTitles String   @default("[]") @db.Text // JSON string[]
  status            String   @default("")
  registeredAt      String   @default("")
  domestic          Boolean  @default(false)
  iswc              String   @default("")
  isrc              String   @default("")
  identifiers       String   @default("[]") @db.Text // JSON [{ code, label, value }]
  genre             String   @default("")
  dates             String   @default("[]") @db.Text // JSON [{ code, value, territory }]
  extra             String   @default("{}") @db.Text // JSON of the remaining dynamic fields
  notes             String   @default("")
  declarationId     String?  @unique
  createdAt         DateTime @default(now())

  shares    WorkShare[]
  lines     DistributionLine[]
  poolWorks DistributionPoolWork[]
  setItems  WorkSetItem[]

  @@index([title])
  @@index([iswc])
}

// One right-holder's share of a work, per territory view and right type
// (performing, mechanical, ...). `share` is stored as WIPO Connect holds it.
model WorkShare {
  id               String           @id @default(cuid())
  work             RegistryWork     @relation(fields: [workId], references: [id], onDelete: Cascade)
  workId           String
  rightHolder      RightHolder?     @relation(fields: [rightHolderId], references: [id], onDelete: SetNull)
  rightHolderId    String?
  name             RightHolderName? @relation(fields: [nameId], references: [id], onDelete: SetNull)
  nameId           String?
  roleCode         String           @default("")
  isPublisher      Boolean          @default(false)
  rightType        String           @default("")
  share            Float            @default(0)
  territoryFormula String           @default("")
  validFrom        String           @default("")
  validTo          String           @default("")

  @@index([workId])
  @@index([rightHolderId])
}

// What one right-holder was allocated on one work in one distribution run.
model DistributionLine {
  id             String                @id @default(cuid())
  distribution   Distribution          @relation(fields: [distributionId], references: [id], onDelete: Cascade)
  distributionId String
  work           RegistryWork?         @relation(fields: [workId], references: [id], onDelete: SetNull)
  workId         String?
  rightHolder    RightHolder?          @relation(fields: [rightHolderId], references: [id], onDelete: SetNull)
  rightHolderId  String?
  roleCode       String                @default("")
  rightType      String                @default("")
  amount         Float                 @default(0) // estimated_amount
  total          Float                 @default(0) // sum_amount
  weight         Float                 @default(0)
  adminFee       Float                 @default(0)
  reserved       Float                 @default(0)
  disputed       Boolean               @default(false)
  // Set when the line was produced by allocating a pool link in the portal;
  // null for lines imported from WIPO Connect.
  link           DistributionPoolLink? @relation(fields: [linkId], references: [id], onDelete: Cascade)
  linkId         String?
  // Why reserved money is held back: Unidentified | Non-society | Incomplete |
  // Undistributable | Disputed. Empty when nothing is reserved.
  reserveType    String                @default("")

  @@index([distributionId])
  @@index([rightHolderId])
  @@index([workId])
  @@index([linkId])
}

// A reusable distribution pool — WIPO Connect's "Distribution Pool" such as
// TV-WL-01: the creation class, right type and method its money is shared by.
model DistributionPool {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String   @default("")
  className     String   @default("") // WIPO "Class", free text (RADIO, TELEVISION, CONCERT …)
  method        String   @default("Work List") // Work List | Log Based | RO List | Reserve | Analogy | CRD
  creationClass String   @default("MW")
  rightType     String   @default("Performing") // which shares are paid from this pool
  adminFeePct   Float    @default(0)
  notes         String   @default("")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // WIPO Connect pool settings. workRoles: JSON list of role codes the pool
  // pays (empty = every role). The methods are formulas; with none the weight
  // or share is used as it stands.
  subClass                   String            @default("")
  workRoles                  String            @default("[]") @db.Text
  workMethod                 AllocationMethod? @relation("PoolWorkMethod", fields: [workMethodId], references: [id], onDelete: SetNull)
  workMethodId               String?
  roMethod                   AllocationMethod? @relation("PoolRoMethod", fields: [roMethodId], references: [id], onDelete: SetNull)
  roMethodId                 String?
  reallocateWithinWork       Boolean           @default(true)
  workShareTolerance         Float             @default(0)
  internationalRevenueStream Boolean           @default(false)
  reserveType                String            @default("")
  // Log Based pools: how the usage log is matched (Log Source) and weighed (Log Allocation Method)
  logSourceId                String?
  logMethodId                String?

  links DistributionPoolLink[]
}

// One pool's money in one distribution run for one station and period —
// WIPO Connect's "Distribution Pool Link" (DPL). The works played are listed on
// the link; allocating it turns amount + works + shares into DistributionLines.
model DistributionPoolLink {
  id             String            @id @default(cuid())
  distribution   Distribution      @relation(fields: [distributionId], references: [id], onDelete: Cascade)
  distributionId String
  pool           DistributionPool? @relation(fields: [poolId], references: [id], onDelete: SetNull)
  poolId         String?
  className      String            @default("") // WIPO "Class", free text (RADIO, TELEVISION, CONCERT …)
  subClass       String            @default("") // WIPO "Sub Class": the station or venue
  periodStart    String            @default("")
  periodEnd      String            @default("")
  amount         Float             @default(0)
  adminFeePct    Float             @default(0) // Domestic admin fee %, copied from the pool; editable
  status         String            @default("To be Allocated") // To be Allocated | Allocating | Allocated | Failed
  allocatedAt    DateTime?
  notes          String            @default("")
  createdAt      DateTime          @default(now())

  seq                 Int               @default(autoincrement()) // shown as 133-<seq>-DPL
  currency            String            @default("ZMW")
  adminFeeIntl        Float             @default(0)
  adminFeeIntlRevenue Float             @default(0)
  adminFeeReserved    Float             @default(0)
  reserveType         String            @default("")
  affiliation         String            @default("ZAMCOPS") // who is paid: ZAMCOPS (affiliated members) | All
  workMethod          AllocationMethod? @relation("LinkWorkMethod", fields: [workMethodId], references: [id], onDelete: SetNull)
  workMethodId        String?
  roMethod            AllocationMethod? @relation("LinkRoMethod", fields: [roMethodId], references: [id], onDelete: SetNull)
  roMethodId          String?
  logSourceId         String?
  logMethodId         String?
  lastError           String            @default("")

  works    DistributionPoolWork[]
  lines    DistributionLine[]
  reserves Reserve[]

  @@index([distributionId])
}

// A work on a pool link's list, with how much it counts (plays / airings).
model DistributionPoolWork {
  id     String               @id @default(cuid())
  link   DistributionPoolLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  linkId String
  work   RegistryWork         @relation(fields: [workId], references: [id], onDelete: Cascade)
  workId String
  weight Float                @default(1)
  // Set by an allocation run: Fully distributable | Partially distributable |
  // Not distributable, with the reason in note.
  status String               @default("")
  note   String               @default("")

  @@unique([linkId, workId])
  @@index([workId])
}

// A named collective of right-holders on the register — a band, ensemble,
// family estate or publishing house with its people. Staff-managed from the
// admin Groups screen; the members are right-holders from the register (or
// free-text names for people who are not on it yet).
model RightHolderGroup {
  id          String   @id @default(cuid())
  name        String
  code        String   @default("")
  kind        String   @default("Group") // Group | Band | Ensemble | Estate | Publisher | Other
  status      String   @default("Active") // Active | Inactive
  description String   @default("")
  notes       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members RightHolderGroupMember[]

  @@index([name])
}

model RightHolderGroupMember {
  id            String           @id @default(cuid())
  group         RightHolderGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId       String
  rightHolder   RightHolder?     @relation(fields: [rightHolderId], references: [id], onDelete: SetNull)
  rightHolderId String?
  displayName   String           @default("")
  role          String           @default("") // e.g. Lead, Member, Manager
  sharePct      Float            @default(0) // optional split inside the group
  notes         String           @default("")

  @@index([groupId])
  @@index([rightHolderId])
}

// A named allocation formula. A Work method turns a work weight (plays) into
// the weight it earns in the pool; a Right owner method turns a right-holder
// share into the weight they earn within the work.
//   Work:        $Weight$   $Work$.shares   $Work$.domestic   $Work$.year
//   Right owner: $Weight$   $Role$   $Ro$.affiliated   $Work$.shares ...
model AllocationMethod {
  id          String   @id @default(cuid())
  name        String
  target      String   @default("Work") // Work | Right owner
  formula     String   @default("$Weight$") @db.Text
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  poolWork DistributionPool[]     @relation("PoolWorkMethod")
  poolRo   DistributionPool[]     @relation("PoolRoMethod")
  linkWork DistributionPoolLink[] @relation("LinkWorkMethod")
  linkRo   DistributionPoolLink[] @relation("LinkRoMethod")

  @@unique([target, name])
}

// A reusable, named list of works (WIPO Connect Work Set) that can be added
// to a pool link in one go.
model WorkSet {
  id          String        @id @default(cuid())
  name        String        @unique
  description String        @default("")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  items       WorkSetItem[]
}

model WorkSetItem {
  id     String       @id @default(cuid())
  set    WorkSet      @relation(fields: [setId], references: [id], onDelete: Cascade)
  setId  String
  work   RegistryWork @relation(fields: [workId], references: [id], onDelete: Cascade)
  workId String
  weight Float        @default(1)

  @@unique([setId, workId])
  @@index([workId])
}

// Money held back from payment in an allocation — WIPO Connect Reserve
// Management. One row per pool link and reason; staff close it, let it
// prescribe, or release it into a later distribution.
model Reserve {
  id                  String                @id @default(cuid())
  distribution        Distribution          @relation(fields: [distributionId], references: [id], onDelete: Cascade)
  distributionId      String
  link                DistributionPoolLink? @relation(fields: [linkId], references: [id], onDelete: Cascade)
  linkId              String?
  className           String                @default("")
  subClass            String                @default("")
  creationClass       String                @default("")
  rightType           String                @default("")
  reserveType         String                @default("") // Unidentified | Non-society | Incomplete | Undistributable | Disputed
  reservedAt          DateTime              @default(now())
  closedAt            DateTime?
  amount              Float                 @default(0)
  distributableAmount Float                 @default(0)
  distributedAmount   Float                 @default(0)
  status              String                @default("Open") // Open | In Distribution | Prescribed | Closed
  notes               String                @default("")

  @@index([distributionId])
  @@index([status, reserveType])
}

// WIPO Connect "Operational" reference data (CMO, Territories, Reference Table
// = creation classes, Identifiers). Seeded from data/wipo/*.json on first use.
model RefCmo {
  id            String @id @default(cuid())
  code          String @unique
  acronym       String @default("")
  name          String @default("")
  country       String @default("")
  type          String @default("")
  creationClass String @default("")
}

model RefTerritory {
  id        String @id @default(cuid())
  tisn      String @unique
  tisa      String @default("")
  name      String @default("")
  type      String @default("")
  startDate String @default("")
  endDate   String @default("")
}

model RefCreationClass {
  id               String @id @default(cuid())
  code             String @unique
  name             String @default("")
  description      String @default("")
  shareBase        Int?
  identifiers      Json   @default("[]")
  additionalFields Json   @default("[]")
  roles            Json   @default("[]")
  domesticRoles    Json   @default("[]")
  domesticFee      Float?
  intlRevenueFee   Float?
  intlFee          Float?
  reservedFee      Float?
}

model RefIdentifier {
  id      String @id @default(cuid())
  code    String @unique
  acronym String @default("")
  name    String @default("")
  entity  String @default("")
  type    String @default("")
  classes Json   @default("[]")
}

// WIPO Connect Agreements and Mandates: who assigned which rights to whom.
// Assignor and assignee are right holders (plain ids so the register is not
// touched); seq is the number shown in the default code.
model Agreement {
  id              String          @id @default(cuid())
  seq             Int             @default(autoincrement())
  code            String          @default("")
  type            String          @default("General") // General | Implied | Specific Exclude | Specific Include
  creationClass   String          @default("")
  assignorId      String?
  assignorName    String          @default("")
  assigneeId      String?
  assigneeName    String          @default("")
  signatureDate   String          @default("")
  sourceType      String          @default("") // Assignee | Assignor | External Source | Sister CMO
  sourceDetail    String          @default("")
  startDate       String          @default("")
  endDate         String          @default("")
  effectiveStart  String          @default("")
  effectiveEnd    String          @default("")
  rightTypes      Json            @default("[]")
  territory       String          @default("")
  shareValue      Float?
  workAssociation String          @default("") // Include Set | Include Work
  status          String          @default("Valid") // Valid | Duplicate Claim | In Dispute | Deleted | Cycle
  comments        Json            @default("[]")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  works           AgreementWork[]

  @@index([assignorId])
  @@index([assigneeId])
  @@index([status])
}

model AgreementWork {
  id          String    @id @default(cuid())
  agreement   Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  agreementId String
  workId      String
  excluded    Boolean   @default(false)

  @@unique([agreementId, workId, excluded])
  @@index([workId])
}

// WIPO Connect Matching Settings: how a usage log file is read (Log Format),
// how its lines are matched to works (Log Source) and how a matched line
// is weighed in a log based pool (Log Allocation Method).
model LogFormat {
  id                  String  @id @default(cuid())
  name                String  @unique
  fileFormat          String  @default("XLSX")
  creationClass       String  @default("MW")
  targetCreationClass String  @default("MW")
  headerLines         Int     @default(1)
  footerLines         Int     @default(0)
  sheetNumber         Int     @default(1)
  manageComponent     Boolean @default(false)
  fields              Json    @default("[]") // [{ column, columnType: Matching|Allocation|Split, targetField, fieldType: String|Integer, targetCode }]
}

model LogSource {
  id                  String  @id @default(cuid())
  name                String  @unique
  formatId            String
  minThreshold        Float   @default(80)
  maxThreshold        Float   @default(100)
  precision           String  @default("0.1")
  roles               Json    @default("[]")
  distrStatus         String  @default("")
  creatorsByPerformer Boolean @default(false)
  similarity          Float?
  numberOfWorks       Int?
  historyEntries      Int     @default(0)
  weights             Json    @default("[]") // [{ column, weight, similarity, method, priority }]
}

model LogAllocationMethod {
  id       String @id @default(cuid())
  name     String @unique
  formatId String
  formula  String @default("")
}

// WIPO Connect Usage Log: one uploaded log file for a distribution pool link.
model UsageLog {
  id             String    @id @default(cuid())
  importCode     String    @default("")
  filename       String    @default("")
  uploadedAt     DateTime  @default(now())
  startedAt      DateTime?
  endedAt        DateTime?
  insertedItems  Int       @default(0)
  groupedItems   Int       @default(0)
  processedItems Int       @default(0)
  errorNumbers   Int       @default(0)
  distributionId String?
  linkId         String?
  sourceId       String?
  status         String    @default("IMPORTED")
  priority       Int       @default(0)

  @@index([distributionId])
  @@index([linkId])
}

// One grouped line of a usage log: every row with the same title / creators /
// identifier collapses to one group, which is matched to a work.
model UsageLogGroup {
  id         String   @id @default(cuid())
  usageLogId String
  key        String
  title      String   @default("")
  creators   String   @default("")
  identifier String   @default("")
  rowsCount  Int      @default(1)
  amount     Float    @default(0) // total of the Allocation column (plays / frequency)
  splits     Json     @default("{}") // Split column totals, e.g. per station
  workId     String?
  score      Float?
  status     String   @default("To be matched") // To be matched | Possible match | Matched | Not matched | Ignored
  candidates Json     @default("[]") // [{ workId, title, score }]
  matchedBy  String   @default("") // auto | history | staff
  updatedAt  DateTime @updatedAt

  @@unique([usageLogId, key])
  @@index([status])
  @@index([workId])
}

// Matches staff confirmed, reused the next time the same title and creators turn up.
model UsageMatchHistory {
  id        String   @id @default(cuid())
  sourceId  String
  key       String
  workId    String
  createdAt DateTime @default(now())

  @@unique([sourceId, key])
}
