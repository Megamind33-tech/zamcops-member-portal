// ZAMCOPS Member Portal — database schema (PostgreSQL).
// DATABASE_URL is the pooled connection used at runtime; DIRECT_URL is the
// direct (non-pooled) connection used for migrations / `prisma db push`.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Staff accounts for the admin dashboard (separate from members).
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
}

// Members of the society — artists, composers, producers, publishers, labels.
model Member {
  id           String   @id @default(cuid())
  memberNumber String   @unique
  email        String   @unique
  phone        String
  passwordHash String

  fullName     String
  stageName    String   @default("")
  nrcOrPassport String  @default("")
  dateOfBirth  String   @default("")
  gender       String   @default("")
  role         String   @default("Artist")

  province     String   @default("")
  district     String   @default("")
  address      String   @default("")

  bankName         String @default("")
  bankAccount      String @default("")
  mobileMoneyNumber String @default("")

  nextOfKinName  String @default("")
  nextOfKinPhone String @default("")

  nrcDocument  String @default("")
  profilePhoto String @default("")

  membershipStatus String   @default("Pending")
  joinedAt         DateTime @default(now())

  works               WorkDeclaration[]
  singles             SongSubmission[]
  albums              AlbumSubmission[]
  uploads             UploadFile[]
  notifications       Notification[]
  statements          Statement[]
  royalty             RoyaltySummary?
  distributionEntries DistributionEntry[]
  licensableWorks     LicensableWork[]
  licenseRequests     LicenseRequest[]
  documents           MemberDocument[]
}

model WorkDeclaration {
  id               String   @id @default(cuid())
  owner            Member   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId          String
  title            String
  alternativeTitle String   @default("")
  workType         String
  language         String
  genre            String
  duration         String   @default("")
  composers        String   @default("[]") // JSON string[]
  authors          String   @default("[]")
  producers        String   @default("[]")
  publisher        String   @default("")
  publisherIpi     String   @default("") // Publisher's IPI / CAE number, for cross-society registration
  ownershipSplits  String   @default("[]") // JSON OwnershipSplit[] — each entry now also carries ipiNumber + rightsType
  isrc             String   @default("")
  iswc             String   @default("")
  audioFile        String   @default("") // reference recording — file name
  dateCreated      String   @default("")
  status           String   @default("Pending")
  submittedAt      DateTime @default(now())

  @@index([ownerId])
}

model SongSubmission {
  id              String   @id @default(cuid())
  owner           Member   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId         String
  title           String
  artistName      String
  featuredArtists String   @default("")
  producer        String   @default("")
  genre           String
  releaseDate     String   @default("")
  isrc            String   @default("")
  audioFile       String   @default("")
  coverArt        String   @default("")
  lyricsFile      String   @default("")
  ownershipSplits String   @default("[]")
  status          String   @default("Pending")
  submittedAt     DateTime @default(now())

  @@index([ownerId])
}

model AlbumSubmission {
  id          String   @id @default(cuid())
  owner       Member   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId     String
  title       String
  artistName  String
  releaseDate String   @default("")
  coverArt    String   @default("") // front cover — image data URL
  backCover   String   @default("") // back cover — image data URL
  tracks      String   @default("[]") // JSON Track[]
  status      String   @default("Pending")
  submittedAt DateTime @default(now())

  @@index([ownerId])
}

model UploadFile {
  id              String   @id @default(cuid())
  owner           Member   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId         String
  fileName        String
  fileType        String
  linkedTo        String   @default("")
  status          String   @default("Pending")
  rejectionReason String   @default("")
  mimeType        String   @default("")
  fileSize        Int      @default(0)
  data            String   @default("") @db.Text // base64 of the file (small files only)
  uploadedAt      DateTime @default(now())

  @@index([ownerId])
}

model Notification {
  id        String   @id @default(cuid())
  owner     Member   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId   String
  title     String
  body      String
  type      String   @default("info")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([ownerId])
}

model Statement {
  id        String   @id @default(cuid())
  owner     Member   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId   String
  type      String
  title     String
  reference String
  amount    Float?
  issuedAt  DateTime @default(now())

  @@index([ownerId])
}

// One royalty summary per member, with usage logs and top songs stored as JSON.
// Note: these are *detected activity* figures (plays/usage) for internal forecasting —
// members are not shown monetary promises here. Confirmed earnings only become visible
// to a member once an admin publishes a Distribution covering the relevant period.
model RoyaltySummary {
  id             String @id @default(cuid())
  owner          Member @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId        String @unique
  currency       String @default("ZMW")
  totalEstimated Float  @default(0)
  pending        Float  @default(0)
  paid           Float  @default(0)
  usageLogs      String @default("[]") // JSON RoyaltyUsageLog[]
  topSongs       String @default("[]") // JSON top songs
}

// A closed, society-wide distribution period. Stays in Draft (admin-only) while
// amounts are being assembled and reviewed; once Published it becomes visible
// to the affected members — this is the gate that keeps royalties from being
// shown "ahead of time".
model Distribution {
  id          String    @id @default(cuid())
  periodLabel String // e.g. "Q1 2026"
  status      String    @default("Draft") // Draft | Published
  notes       String    @default("")
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  entries DistributionEntry[]
}

// A member's confirmed payout within a given distribution period.
model DistributionEntry {
  id             String       @id @default(cuid())
  distribution   Distribution @relation(fields: [distributionId], references: [id], onDelete: Cascade)
  distributionId String
  owner          Member       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId        String
  amount         Float        @default(0)
  currency       String       @default("ZMW")
  topSongs       String       @default("[]") // JSON [{ title, plays, amount }] — breakdown for this period

  @@unique([distributionId, ownerId])
  @@index([ownerId])
}

// A catalog work the member has opted into ZAMCOPS' direct/sync licensing pool —
// businesses (film, ads, online media, events) can request to license it, with
// ZAMCOPS facilitating the deal and earning a facilitation fee alongside the member.
model LicensableWork {
  id         String   @id @default(cuid())
  owner      Member   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId    String
  workTitle  String
  workRef    String   @default("") // optional id of a linked song/album/work
  usageTypes String   @default("[]") // JSON string[], e.g. ["Film & TV","Advertising","Online content","Live events"]
  minFee     Float?
  notes      String   @default("")
  status     String   @default("Active") // Active | Paused
  createdAt  DateTime @default(now())

  requests LicenseRequest[]

  @@index([ownerId])
}

// An inbound licensing enquiry from a business, brokered by ZAMCOPS.
model LicenseRequest {
  id               String         @id @default(cuid())
  work             LicensableWork @relation(fields: [workId], references: [id], onDelete: Cascade)
  workId           String
  owner            Member         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId          String
  requesterName    String
  requesterCompany String         @default("")
  requesterEmail   String
  usageType        String
  description      String         @default("")
  proposedFee      Float?
  facilitationFee  Float?
  status           String         @default("Submitted") // Submitted | In review | Offer sent | Accepted | Declined
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([ownerId])
  @@index([workId])
}

// Official documents an admin attaches to a member's file — clearance letters,
// deeds of assignment, signed contracts, ID copies, etc. (File bytes are not
// stored yet; this records the document metadata / filename.)
model MemberDocument {
  id         String   @id @default(cuid())
  owner      Member   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId    String
  docType    String // Clearance Letter | Deed of Assignment | Contract | ID Document | Other
  fileName   String
  reference  String   @default("")
  note       String   @default("")
  uploadedAt DateTime @default(now())

  @@index([ownerId])
}
