# Build context — keep it to the sources the image actually needs.
node_modules
.next
.git
.github
.cursor
coverage
*.log
.env
.env.*
!.env.example
Dockerfile
docker-compose.yml
docker-compose.*.yml
README.md
tsconfig.tsbuildinfo

# NOTE: do not exclude `data/` — despite the name it is not a data directory,
# it is source. data/reference.ts holds the province, genre and language lists
# that the profile and submission pages import as @/data/reference, and
# excluding it fails the build with "Module not found: Can't resolve
# '@/data/reference'".
