# PostgreSQL connection used by the app at runtime (use the POOLED Neon URL).
# Self-hosting with docker compose? Leave these two alone — compose builds them
# from POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB below and passes them in.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Direct (non-pooled) connection used for migrations / prisma db push
# (the same host without the "-pooler" suffix). With a plain PostgreSQL server
# there is no pooler, so this is the same URL as DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# ── Self-hosting on your own VPS (docker compose) ─────────────────────────────
# Only these are read by docker-compose.yml; ignore them on Vercel.
#
#   PORTAL_DOMAIN     the domain Caddy gets an HTTPS certificate for. Point its
#                     A/AAAA record at the VPS BEFORE the first `up`, or the
#                     certificate request fails.
#   ACME_EMAIL        where Let's Encrypt sends expiry warnings.
#   POSTGRES_*        credentials for the bundled PostgreSQL container. The
#                     password is required and has no default — pick a long
#                     random one; nothing outside the compose network can reach
#                     the database, but it is still the key to every record.
PORTAL_DOMAIN="portal.zamcops.org.zm"
ACME_EMAIL=""
POSTGRES_USER="zamcops"
POSTGRES_PASSWORD=""
POSTGRES_DB="zamcops"

# Secret used to sign session JWTs. Use a long random string in production.
AUTH_SECRET="change-me-to-a-long-random-secret"

# Staff (admin dashboard) account — created on first admin sign-in.
ADMIN_EMAIL="admin@zamcops.org.zm"
ADMIN_PASSWORD="admin123"
ADMIN_NAME="ZAMCOPS Staff"

# ── Large-file storage (optional — pick one; without any of them, uploads are ─
#    capped at 4MB and stored inline in the database)
#
# Simplest when you host it yourself: a directory on the VPS. Set
# LOCAL_STORAGE_DIR and audio masters, artwork and documents are written there
# (up to 300MB each) instead of into PostgreSQL. It takes precedence over R2 and
# Vercel Blob, needs no account anywhere, and nothing under it is served
# statically — every download goes through an authenticated route.
#
# docker compose already sets this to /data/uploads and mounts the `uploads`
# volume there; set it yourself only when running outside Docker. Back this
# directory up together with the database — one is useless without the other.
LOCAL_STORAGE_DIR=""
#
# Preferred: Cloudflare R2 (free tier: 10GB storage, zero egress fees).
# 1. Cloudflare dashboard → R2 → Create bucket (keep it PRIVATE).
# 2. R2 → Manage API Tokens → create a token with Object Read & Write on the
#    bucket; copy the Access Key ID + Secret. The Account ID is shown on the
#    R2 overview page.
# 3. On the bucket → Settings → CORS policy, allow browser uploads:
#    [{ "AllowedOrigins": ["https://www.zamcopsportal.org", "https://zamcopsportal.org"],
#       "AllowedMethods": ["PUT"], "AllowedHeaders": ["content-type"], "MaxAgeSeconds": 3600 }]
# 4. Fill in the four values below, then verify the whole path end to end
#    with `npm run check:r2` (presigned PUT + GET, private-bucket and CORS
#    checks, then cleanup). All four are required — leave any one blank and
#    the app silently falls back to Vercel Blob, then to inline storage.
#    `npm run preflight` checks this together with the database, email and SMS.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# Any other S3-compatible store — MinIO in a container beside the portal, or a
# provider other than Cloudflare. Set S3_ENDPOINT and the same credentials are
# signed against it instead of the Cloudflare host (R2_ACCOUNT_ID is then
# unused). S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY / S3_BUCKET work as aliases
# of the R2_* names above.
# S3_ENDPOINT="http://minio:9000"
# S3_REGION="us-east-1"

# Alternative: Vercel Blob — connect a Blob store in the Vercel dashboard
# (Storage tab), which injects this automatically:
# BLOB_READ_WRITE_TOKEN=""

# ── Outbound notifications (both optional — leave unset to disable a channel) ──

# Email via Resend (https://resend.com). EMAIL_FROM must be a sender on a
# domain you've verified in Resend, e.g. "ZAMCOPS <no-reply@zamcopsportal.org>".
# If EMAIL_FROM is unset, the shared "onboarding@resend.dev" sender is used —
# Resend only delivers that to the account owner's inbox, so it's for testing.
# Registration OTP codes also go through this channel.
RESEND_API_KEY=""
EMAIL_FROM=""

# SMS via Africa's Talking (https://africastalking.com — good Zambia coverage).
# Use username "sandbox" with a sandbox API key for testing.
AT_USERNAME=""
AT_API_KEY=""
# Optional registered alphanumeric sender ID / shortcode:
AT_SENDER_ID=""
