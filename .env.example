# PostgreSQL connection used by the app at runtime (use the POOLED Neon URL).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Direct (non-pooled) connection used for migrations / prisma db push
# (the same host without the "-pooler" suffix).
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Secret used to sign session JWTs. Use a long random string in production.
AUTH_SECRET="change-me-to-a-long-random-secret"

# Staff (admin dashboard) account — created on first admin sign-in.
ADMIN_EMAIL="admin@zamcops.org.zm"
ADMIN_PASSWORD="admin123"
ADMIN_NAME="ZAMCOPS Staff"

# ── Outbound notifications (both optional — leave unset to disable a channel) ──

# Email via Resend (https://resend.com). EMAIL_FROM must be a sender on a
# domain you've verified in Resend, e.g. "ZAMCOPS <no-reply@zamcops.org.zm>".
RESEND_API_KEY=""
EMAIL_FROM=""

# SMS via Africa's Talking (https://africastalking.com — good Zambia coverage).
# Use username "sandbox" with a sandbox API key for testing.
AT_USERNAME=""
AT_API_KEY=""
# Optional registered alphanumeric sender ID / shortcode:
AT_SENDER_ID=""
