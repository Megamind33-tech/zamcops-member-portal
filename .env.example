# Database connection. Defaults to a local SQLite file for the prototype.
# For a hosted deploy, set the schema datasource provider to "postgresql"
# and point this at your database (e.g. postgres://user:pass@host:5432/db).
DATABASE_URL="file:./dev.db"

# Secret used to sign session JWTs. Use a long random string in production.
AUTH_SECRET="change-me-to-a-long-random-secret"

# Seed staff (admin dashboard) account. Created on first admin sign-in.
ADMIN_EMAIL="admin@zamcops.org.zm"
ADMIN_PASSWORD="admin123"
ADMIN_NAME="ZAMCOPS Staff"
